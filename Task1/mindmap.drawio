        <mxCell id="no0k5Ghd743jE-9ItUDu-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;" value="&lt;p&gt;&lt;b&gt;Данные:&lt;/b&gt; онлайн-витрина объектов недвижимости (фотографии, описания, цены)&lt;/p&gt;&lt;p&gt;&lt;b&gt;Риски:&lt;/b&gt; потеря, искажение, обесценивание, некачественные данные&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Оценка рисков:&lt;/b&gt; значительный&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="40" y="-420" as="geometry" />
        </mxCell>
        <mxCell id="no0k5Ghd743jE-9ItUDu-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;" value="&lt;p&gt;&lt;b&gt;Обоснование:&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;потеря данных онлайн-витрины может привести к остановке продаж. Е&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;сли цена и планировка в онлайн-витрине являются публичной офертой, то их искажение/обесценивание ведет к финансовым потерям. Н&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;екачественные фото объектов снижают конверсию продаж&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="-40" y="-640" as="geometry" />
        </mxCell>
        <mxCell id="no0k5Ghd743jE-9ItUDu-19" edge="1" parent="1" source="no0k5Ghd743jE-9ItUDu-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" target="no0k5Ghd743jE-9ItUDu-15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="no0k5Ghd743jE-9ItUDu-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;" value="&lt;p&gt;&lt;b&gt;Данные:&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;информация от управляющей компании (новости, объявления о ремонтах)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Риски:&lt;/b&gt; потеря, искажение, обесценивание&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Оценка рисков:&lt;/b&gt;&amp;nbsp;незначительный&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="320" y="-420" as="geometry" />
        </mxCell>
        <mxCell id="no0k5Ghd743jE-9ItUDu-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;" value="&lt;p&gt;&lt;b&gt;Обоснование:&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;скорее всего, информация дублируется на информационных стендах в самих ЖК&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="360" y="-640" as="geometry" />
        </mxCell>
